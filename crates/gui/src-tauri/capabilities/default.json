{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal explicit IPC allowlist for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-title",
    "allow-pick-scan-roots",
    "allow-pick-rules-file",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-query-scan-entries",
    "allow-get-treemap-nodes",
    "allow-get-workspace-status",
    "allow-get-suggested-directories",
    "allow-pick-and-preview-grant",
    "allow-confirm-grant",
    "allow-revoke-grant",
    "allow-pick-and-preview-storage-init",
    "allow-confirm-storage-init",
    "allow-open-existing-storage",
    "allow-pick-destination-directory",
    "allow-build-plan-from-selection",
    "allow-filter-plan-operations",
    "allow-request-permanent-challenge",
    "allow-confirm-and-execute",
    "allow-cancel-execution",
    "allow-list-quarantine",
    "allow-build-restore-plan",
    "allow-build-purge-plan",
    "allow-list-history",
    "allow-get-batch-detail",
    "allow-build-undo-plan",
    "allow-get-recovery-report"
  ]
}
